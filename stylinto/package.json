{
  "name": "tpl-fashion-and-beauty-stylinto",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npx serve src",
    "build": "echo static site, no build step",
    "verify": "echo static site, nothing to verify"
  },
  "dependencies": {},
  "engines": {
    "node": ">=22.0.0"
  },
  "agentMeta": {
    "category": "fashion-and-beauty",
    "idealFor": [
      "fashion boutiques",
      "online clothing stores",
      "apparel brands"
    ],
    "buildOutputDir": "src",
    "customizationMap": {
      "themeColors": "src/css/style.css",
      "siteMetadata": "src/index.html (<head> title and meta tags)",
      "navigation": "src/index.html (<header>/<nav> block, repeated in each page)",
      "pagesDir": "src"
    },
    "requiredClientInputs": [
      "storeName",
      "primaryColorHex",
      "logoUrl",
      "contactEmail"
    ]
  }
}
